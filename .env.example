# OLLIN — environment configuration
# Copy to .env.local for development, and add these in Vercel → Settings →
# Environment Variables for production.

# ── Supabase (persistent, shared storage) ─────────────────────────────
# Project URL — Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret (service_role) key — SERVER ONLY. Bypasses RLS; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Session signing ────────────────────────────────────────────────────
# Stable secret so all serverless instances validate the same cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Built-in admin ─────────────────────────────────────────────────────
# Password accepted for the built-in admin account (admin-001).
ADMIN_PASSWORD=

# ── AI providers (optional; keys can also be added in Admin → Settings) ─
# Comma-separated for multiple keys with automatic rotation/fallback.
GROQ_API_KEY=
GROQ_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=
